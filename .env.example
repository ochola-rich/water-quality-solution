# Server Configuration
PORT=8080
DB_PATH=./guardians.db
MIGRATIONS_DIR=./migrations
UPLOADS_DIR=./uploads
STATIC_DIR=../frontend
AUTO_MIGRATE=true

# Lightning Network (LNbits) Configuration
# Leave blank to use mock Lightning mode in local development
LNBITS_URL=https://legend.lnbits.com
LNBITS_ADMIN_KEY=your_lnbits_admin_api_key_here
LNBITS_INVOICE_KEY=your_lnbits_invoice_api_key_here

# Blockchain / Hedera / Polygon Testnet Configuration (Phase 2)
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.xxxxxx
HEDERA_PRIVATE_KEY=your_hedera_private_key_here
