# Server Configuration
PORT=8080
ENV=development

# Database
DB_PATH=./guardians.db

# Static & Uploads
STATIC_DIR=../frontend
UPLOADS_DIR=./uploads

# Lightning Network (LNbits)
LNBITS_URL=https://legend.lnbits.com
LNBITS_API_KEY=your_lnbits_api_key_here
LNBITS_ADMIN_KEY=your_lnbits_admin_key_here
LNBITS_WALLET_ID=your_lnbits_wallet_id_here
REWARD_AMOUNT_SATS=50

# Verification Parameters
VERIFICATION_THRESHOLD=2.0
MAX_VERIFICATION_DISTANCE_METERS=500
MAX_VERIFICATIONS_PER_HOUR=10
