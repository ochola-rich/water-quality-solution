# Guardians of the Lake - Frontend Environment Configuration
# Copy this file to .env or inject into window.API_BASE_URL for custom deployments

# Base URL of the Go Fiber Backend API (default: http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# WebSocket Telemetry Stream URL (default: ws://localhost:3000/ws/dashboard)
VITE_WS_URL=ws://localhost:3000/ws/dashboard
WS_BASE_URL=ws://localhost:3000/ws/dashboard
